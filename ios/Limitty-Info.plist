<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleVersion</key>
	<string>105001</string>
	<key>CFBundleShortVersionString</key>
	<string>1.05.001</string>
	<key>CFBundleDisplayName</key>
	<string>Limitty</string>
	<!-- limitty://agents and limitty://tasks: opened from notifications and the widget. -->
	<!-- Lets iOS wake Limitty now and then to check on your agents and alert you. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.limitty.app.refresh</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Limitty</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>limitty</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
